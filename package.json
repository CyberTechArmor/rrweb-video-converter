{
  "name": "rrweb-video-converter",
  "version": "1.0.0",
  "description": "Self-contained rrweb-to-video conversion service",
  "private": true,
  "scripts": {
    "start:server": "node server/index.js",
    "start:worker": "node server/worker.js",
    "start": "concurrently \"npm run start:server\" \"npm run start:worker\"",
    "dev": "concurrently \"npm run start:server\" \"npm run start:worker\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npx vite",
    "build:frontend": "cd frontend && npx vite build",
    "postinstall": "cd frontend && npm install"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "concurrently": "^9.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "fluent-ffmpeg": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "puppeteer": "^23.7.0",
    "rrweb": "^1.1.3",
    "uuid": "^10.0.0"
  }
}
